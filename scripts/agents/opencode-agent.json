{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git worktree*": "deny",
      "gh *": "deny",
      "aws *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sudo *": "deny",
      "opencode *": "deny",
      "python* scripts/agents.py launch*": "deny",
      "pip install*": "deny",
      "pip3 install*": "deny",
      "uv add*": "deny",
      "npm install*": "deny"
    }
  }
}

